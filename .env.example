# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Duplicate this file as '.env' and fill in your personal/corporate values.
# NEVER commit your real '.env' file with real credentials to GitHub.
# ==============================================================================

# Target email recipient for executive reports
RECIPIENT_EMAIL=management@example.com

# Cloud storage URL to fetch daily sales files
DRIVE_URL=https://drive.google.com/drive/folders/your_folder_id_here

# Relative path to the local sales spreadsheet (inside project directory)
DATA_PATH=data/Vendas - Dez.xlsx

# Sender signature in outgoing emails
SENDER_NAME=Sales Operations Team
